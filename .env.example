# RTI One — server-side secrets (never committed; .env is gitignored)
#
# Groq inference provider. Without this key the app runs on the safe
# deterministic fallback interpreter — no fake results are produced.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Guided-session token/request manager (Phase 4) -----------------------
# All optional; conservative defaults apply when unset. These bound Groq usage
# during development, testing and demos. The manager fails CLOSED (safe
# deterministic fallback) when a limit is hit — it never silently retries.
#
# GUIDE_MAX_CALLS_PER_SESSION=6            # hard cap on model calls per guided session
# GUIDE_REQUESTS_PER_MINUTE=15             # global limit across all sessions
# GUIDE_MAX_OUTPUT_TOKENS_PER_SESSION=12000
# GUIDE_MAX_RETRIES=2                      # bounded retries for transient 429/5xx
# GUIDE_BACKOFF_BASE_MS=250               # exponential backoff base
# GUIDE_CACHE_TTL_MS=300000               # dedup cache lifetime (5 min)

# Opt-in smoke test only (see `npm run smoke`). Never used by the automated test
# suite — vitest always runs on mocked/deterministic providers.
# SMOKE_NEED="I need records from the Ministry of Railways about lift repairs."
